# ============================================================
# 認証情報テンプレート
#
# このファイルを .env にコピーして実際の値を入れる。
#   cp .env.example .env
#
# .env は .gitignore で除外されている。絶対にコミットしないこと。
# ============================================================

# ------------------------------------------------------------
# kabuステーションAPI (三菱UFJ eスマート証券)
# ------------------------------------------------------------
# kabuステーションアプリの [システム設定] → [API] タブで設定したパスワード。
# 本番用と検証用でパスワードは別々に設定する。
KABUS_API_PASSWORD=
KABUS_API_PASSWORD_TEST=

# API のエンドポイント。本番 18080 / 検証 18081。
# kabuステーションアプリが常駐している同一 Windows PC の localhost を指す。
KABUS_BASE_URL=http://localhost:18080/kabusapi

# ------------------------------------------------------------
# J-Quants API (日本取引所グループ)
# ------------------------------------------------------------
# ダッシュボードで発行する API キー (V2 方式)。
# V1 のリフレッシュトークン方式は廃止済み。
JQUANTS_API_KEY=

# ------------------------------------------------------------
# 通知 (障害・キルスイッチ発動・日次レポートの送信先)
# ------------------------------------------------------------
# 未設定ならローカルログのみに出力する。
NOTIFY_WEBHOOK_URL=

# ------------------------------------------------------------
# 実行モード
# ------------------------------------------------------------
# backtest | paper | live
# live は実弾。合格基準 (docs/07-go-live-criteria.md) を満たすまで使わない。
TRADING_MODE=paper
